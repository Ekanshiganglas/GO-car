# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=gocar

# JWT Authentication
JWT_SECRET=gocar-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Stripe (optional - payments simulated if not set)
STRIPE_SECRET_KEY=

# Google Gemini AI (optional - rule-based fallback used if not set)
GEMINI_API_KEY=

# SMTP Email (optional - logs to console if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Default Admin Account
ADMIN_EMAIL=admin@gocar.com
ADMIN_PASSWORD=admin123
